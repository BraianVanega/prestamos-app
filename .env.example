# Supabase local (`pnpm db:up`); `supabase status` muestra los valores
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth (local: `supabase status -o env` → API_URL, PUBLISHABLE_KEY, SECRET_KEY)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Solo para `pnpm db:seed` (crea las cuentas en Auth). Nunca en el cliente.
SUPABASE_SECRET_KEY=

# Contraseñas iniciales que setea `pnpm db:seed` al crear las cuentas (mínimo 10 caracteres)
SEED_PASSWORD_SOCIO_1=
SEED_PASSWORD_SOCIO_2=
